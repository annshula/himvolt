# Public site origin — used for canonical URLs, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://himvolt.com

# Shopify Storefront API. Leave unset and the site runs off lib/product.ts;
# set both and lib/shopify.ts takes over with no component changes.
# SHOPIFY_STORE_DOMAIN=himvolt.myshopify.com
# SHOPIFY_STOREFRONT_TOKEN=

# Shopify Admin API — powers `npm run shopify:sync-product`. Either a
# client-credentials pair (2026 Dev Dashboard apps) or a legacy static token
# works.
# SHOPIFY_ADMIN_CLIENT_ID=
# SHOPIFY_ADMIN_CLIENT_SECRET=
# SHOPIFY_ADMIN_API_TOKEN=

# CJDropshipping API — powers /track (order/shipment lookup). Leave unset and
# the tracking page returns an honest "not connected yet" instead of faking
# results; set both and lib/cj.ts takes over.
CJ_API_EMAIL=
CJ_API_KEY=

# Microsoft Clarity — heatmaps + session replay. Public by design (it ships to
# the browser). clarity.microsoft.com → your project → Settings → Overview →
# Project ID. Leave blank to disable Clarity entirely.
NEXT_PUBLIC_CLARITY_PROJECT_ID=y9rjh6evpn

# Meta (Facebook) Pixel — ad conversion tracking. Public by design (it ships to
# the browser). business.facebook.com → Events Manager → Data sources → Pixel
# ID. Leave blank to disable the pixel entirely.
NEXT_PUBLIC_META_PIXEL_ID=933440732518653

# Meta Conversions API (server-side) — the Purchase event is sent from the
# orders/paid webhook because the shopper pays on Shopify's hosted checkout,
# so the browser pixel can never see it. Shares the pixel id above; the access
# token comes from business.facebook.com → Events Manager → Settings →
# Conversions API. Leave blank to skip CAPI (the webhook still acks Shopify).
META_CAPI_ACCESS_TOKEN=
