# Public site origin — used for canonical URLs, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://himvolt.com

# Shopify Storefront API. Leave unset and the site runs off lib/product.ts;
# set both and lib/shopify.ts takes over with no component changes.
# SHOPIFY_STORE_DOMAIN=himvolt.myshopify.com
# SHOPIFY_STOREFRONT_TOKEN=

# Shopify Admin API — powers `npm run shopify:sync-product`. Either a
# client-credentials pair (2026 Dev Dashboard apps) or a legacy static token
# works.
# SHOPIFY_ADMIN_CLIENT_ID=
# SHOPIFY_ADMIN_CLIENT_SECRET=
# SHOPIFY_ADMIN_API_TOKEN=

# CJDropshipping API — powers /track (order/shipment lookup). Leave unset and
# the tracking page returns an honest "not connected yet" instead of faking
# results; set both and lib/cj.ts takes over.
CJ_API_EMAIL=
CJ_API_KEY=
