# Canonical origin — used for canonical URLs, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://himvolt.com

# ── Shopify ───────────────────────────────────────────────────────────────
# Storefront API. Leave unset and the site runs off lib/product.ts; set both
# and lib/shopify.ts takes over with no component changes.
# SHOPIFY_STORE_DOMAIN=himvolt.myshopify.com
# SHOPIFY_STOREFRONT_API_TOKEN=
SHOPIFY_API_VERSION=2026-07

# Admin API — powers `npm run shopify:sync-product` and the /api/admin/*
# routes. Either a client-credentials pair (2026 Dev Dashboard apps) or a
# legacy static token works; the two are mutually exclusive.
# SHOPIFY_ADMIN_CLIENT_ID=
# SHOPIFY_ADMIN_CLIENT_SECRET=
# SHOPIFY_ADMIN_API_TOKEN=

# Customer Account API — powers /account/* (login, order history).
# SHOPIFY_CUSTOMER_ACCOUNT_SHOP_ID=
# SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=

# HMAC secret Shopify signs webhook payloads with (Admin → Settings →
# Notifications → Webhooks, or set when registering via the Admin API).
# Required for /api/webhooks/* to accept a delivery.
SHOPIFY_WEBHOOK_SECRET=

# Restricts which vendors' products the products webhook accepts. Optional —
# defaults to "HIMVOLT" (a comma-separated list is also accepted).
# SHOPIFY_ALLOWED_PRODUCT_BRANDS=HIMVOLT

# Signs the /account/* session cookie. Any long random string; rotating it
# logs every signed-in customer out.
SESSION_SECRET=

# ── Internal merchant/diagnostic routes (/api/admin/*) ───────────────────
# Bearer token the sync/revalidate routes require. Leave unset and those
# routes stay locked (401), which is safe — they must never be customer-reachable.
ADMIN_API_KEY=

# Vercel Blob — durable storage for data/product.json in production, where a
# deployed function's filesystem is read-only outside /tmp. Auto-provided by
# Vercel once a Blob store is linked to the project; leave unset locally and
# the catalog sync falls back to writing the file straight to disk.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Microsoft Clarity — heatmaps + session replay. Public by design (it ships to
# the browser). clarity.microsoft.com → your project → Settings → Overview →
# Project ID. Leave blank to disable Clarity entirely.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ── Meta (Facebook) Pixel ────────────────────────────────────────────────
# Ad conversion tracking. Public by design (it ships to the browser).
# business.facebook.com → Events Manager → Data sources → Pixel ID. Leave
# blank to disable the pixel entirely.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API (server-side) — the Purchase event is sent from the
# orders/paid webhook because the shopper pays on Shopify's hosted checkout,
# so the browser pixel can never see it. Shares the pixel id above; the access
# token comes from business.facebook.com → Events Manager → Settings →
# Conversions API. Leave blank to skip CAPI (the webhook still acks Shopify).
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0

# Meta Events Manager → Test Events issues a per-account code that tags an
# event as test traffic (visible live in that tool, excluded from ad
# optimization/reporting). Set only while verifying the pipeline end-to-end;
# leave unset in production so a manual test never counts as a real conversion.
# META_TEST_EVENT_CODE=

# ── Google Analytics 4 ───────────────────────────────────────────────────
# analytics.google.com → Admin → Data streams → your stream → Measurement ID.
# Leave blank to disable GA4 entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# GA4 Measurement Protocol (server-side) — same rationale as Meta CAPI: the
# purchase event fires from the orders/paid webhook. Admin → Data streams →
# your stream → Measurement Protocol API secrets → Create. Leave blank to
# skip it (the webhook still acks Shopify).
GA_MP_API_SECRET=

# ── Google Tag Manager ───────────────────────────────────────────────────
# tagmanager.google.com → your container → Container ID (GTM-XXXXXXX). Leave
# blank to disable GTM entirely.
NEXT_PUBLIC_GTM_ID=

# ── TikTok Pixel ─────────────────────────────────────────────────────────
# Conversion tracking for TikTok ads. Public by design (it ships to the
# browser). TikTok Ads Manager → Assets → Events → your pixel → Pixel code →
# Pixel ID. Leave blank to disable the pixel entirely.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# TikTok Events API (server-side) — same rationale as Meta CAPI above: the
# Purchase event fires from the orders/paid webhook. TikTok Ads Manager →
# Assets → Events → your pixel → Settings → Generate access token. Leave
# blank to skip it (the webhook still acks Shopify).
TIKTOK_ACCESS_TOKEN=

# ── CJDropshipping ───────────────────────────────────────────────────────
# Powers /track (order/shipment lookup). Leave unset and the tracking page
# returns an honest "not connected yet" instead of faking results; set both
# and lib/cj.ts takes over.
CJ_API_EMAIL=
CJ_API_KEY=
